# Firebase 설정 — 실제 값은 .env.local 에 넣고 커밋하지 않습니다.
# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹)에서 확인할 수 있습니다.
#
# 이 값들이 비어 있으면 앱은 자동으로 "로컬 전용 모드"로 동작합니다.
# (게임은 그대로 되고, 기록은 브라우저 localStorage 에만 저장됩니다.)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 교사용 현황 페이지 접근 코드 (간단한 접근 보호).
# 비워 두면 접근 코드 없이 열람할 수 있습니다.
NEXT_PUBLIC_TEACHER_ACCESS_CODE=
